# ============================================
# LensyPOS - repo .gitignore
# The app lives in web/ (see web/.gitignore for web-specific entries).
# ============================================

# Node
node_modules/
dist/
dist-ssr/
*.local

# Environment files (never commit real credentials)
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Legacy local data from the retired Python app - never commit customer data
pos_data.json
lensy_pos.db
uploads/

# Delivery packages / archives
LensyPOS_Delivery_*/
*.zip

# Python leftovers (no Python app any more; keeps stray files out of the repo)
__pycache__/
*.py[codz]
.venv/
.pytest_cache/
.ruff_cache/

# IDE / editors
.idea/
.vscode/
*.code-workspace

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*~

# Tunnels
ngrok.exe
cloudflared*.exe
