# Copy to .env.local and fill in. Both Supabase values are public (anon key is
# browser-safe IF Row-Level Security is enabled on every table — see supabase/SETUP.md).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Staff log in with a username; it's mapped to "<username>@<this-domain>" for
# Supabase Auth. Use the same domain when creating users in the dashboard.
VITE_AUTH_EMAIL_DOMAIN=lensypos.local
