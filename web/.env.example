# Copy to .env.local and fill in. Both Supabase values are public (anon key is
# browser-safe IF Row-Level Security is enabled on every table — see supabase/SETUP.md).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Staff log in with a username; it's mapped to "<username>@<this-domain>" for
# Supabase Auth. Use the same domain when creating users in the dashboard.
VITE_AUTH_EMAIL_DOMAIN=lensypos.local

# ---- Deployment mode (see web/OFFLINE.md) ----------------------------------
# supabase (default) - browser talks to Supabase directly (today's behaviour).
# local              - the SHOP PC: works fully offline on IndexedDB and
#                      replicates every change one-way to Supabase when online.
VITE_DATA_MODE=supabase

# Hosted owner/phone build only (with VITE_DATA_MODE=supabase): reads Supabase,
# refuses every write. The shop PC is the only writer.
VITE_READ_ONLY=false

# Public URL of the hosted app. The shop PC runs on localhost, which phones
# can't open, so "attach from mobile" QR codes point here. Optional.
VITE_CLOUD_URL=
