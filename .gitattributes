# The schema baseline is a generated pg_dump committed verbatim by CI. Mark it
# -text so git never applies eol normalization to it: a Windows checkout must not
# rewrite the file, or every future diff against it is 300+ phantom line-ending
# changes instead of the real schema delta.
web/supabase/baseline/*.sql -text

# The schema fingerprint is a single hash line compared with `cat` in CI. A
# Windows checkout must not add a CR, or `cat` yields "<hash>\r" and every
# comparison fails against a schema that has not changed at all. Same reasoning
# as the baseline dump above, so -text rather than eol=lf.
web/supabase/schema.fingerprint -text

# Shell scripts must be LF in the repository, always. core.autocrlf=true on
# Windows would otherwise check them out with CRLF, and `bash script.sh` then
# fails on a shebang carrying a stray CR. The stamp check is now a gate that runs
# on every `npm run test:db`, so a checkout difference that breaks it on exactly
# one developer's machine is a trap rather than an inconvenience.
*.sh text eol=lf
